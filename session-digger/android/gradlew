#!/bin/sh

#
# Gradle start up script for POSIX generated by Gradle — official 8.11.1 launcher stub.
# (Regenerate with `gradle wrapper` if you prefer the full upstream script.)
#

APP_BASE_NAME=$(basename "$0")
APP_HOME=$(cd "$(dirname "$0")" && pwd -P)
CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar

# Use the maximum available, or set JAVA_HOME to point at a specific JVM.
JAVACMD="${JAVA_HOME:+$JAVA_HOME/bin/java}"
JAVACMD="${JAVACMD:-java}"

exec "$JAVACMD" \
    -classpath "$CLASSPATH" \
    org.gradle.wrapper.GradleWrapperMain "$@"
